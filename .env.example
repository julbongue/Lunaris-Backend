# LUNARIS API configuration
APP_NAME=LUNARIS API
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Comma-free JSON list for pydantic-settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Scientific engine: "geometric" is the MVP baseline. A future SPICE engine can
# be registered in app/services/engine/registry.py and selected here.
SCIENTIFIC_ENGINE=geometric

# Analysis limits
MAX_ANALYSIS_SPAN_DAYS=35
MAX_ANALYSIS_SAMPLES=5000
MAX_COMPARISON_SCENARIOS=6
EPHEMERIS_CACHE_TTL_SECONDS=300
ANALYSIS_STORE_TTL_SECONDS=1800
ANALYSIS_STORE_MAX_ENTRIES=256

# PostgreSQL (Supabase) - table populated by data_pipeline/etl/load_lunar_data.py
# The ETL and the API accept reserved characters (e.g. @) in the password;
# percent-encoding them is also valid.
# Direct db.<ref>.supabase.co hosts may be IPv6-only; the connection pooler is
# IPv4: user postgres.<project-ref> and port 6543 (transaction) or 5432 (session).
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
LUNAR_SITES_TABLE=lunar_sites
DATABASE_POOL_PRE_PING=true

# Alternative credentials for the ETL when DATABASE_URL is absent.
# The ETL combines these values with SQLAlchemy URL.create, so the password
# may contain raw reserved characters.
# POSTGRES_HOST=db.example.supabase.co
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=postgres

# JPL Horizons
HORIZONS_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api
HORIZONS_TIMEOUT_SECONDS=45
HORIZONS_MAX_RETRIES=1
HORIZONS_MAX_CONCURRENT=4

# Topography / map layers
LROC_WMS_URL=https://wms.im-ldi.com/lroc/wms
MOONTREK_TILES_URL=https://trek.nasa.gov/tiles/Moon
MOONTREK_CATALOG_URL=https://trek.nasa.gov/moon/TrekServices/ws/index/eq/listVisibleLayers
TOPOGRAPHY_DEFAULT_SIZE_DEG=0.5
TOPOGRAPHY_MAP_SIZE_PX=1024
